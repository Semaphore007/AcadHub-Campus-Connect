# Database Configuration
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=acadnet
PG_USER=
PG_PASSWORD=

# Next.js / Better Auth PostgreSQL connection (replace the placeholders)
DATABASE_URL=postgres://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/acadnet

# JWT Secrets
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Email Configuration  
APP_EMAIL=
APP_PASSWORD=

# OAuth
CLIENT_ID=
CLIENT_PASSPORT=

# Server
BACKEND_PORT=
FRONTEND_PORT=
NODE_ENV=

# ─── Better Auth ──────────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set true only when both Google OAuth values are configured above.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# ─── Documentation site (Next.js) ────────────────────────────
# Base URL of the existing Express backend, e.g. http://localhost:3000. Leave empty to use mock data.
NEXT_PUBLIC_API_BASE_URL=
# Only set if a real deployment of the AcadHub app exists.
NEXT_PUBLIC_DEMO_URL=

# ─── AI Study Buddy ───────────────────────────────────────────
# Free Google Gemini API key from https://aistudio.google.com/
# If not set, Hub runs in demo mode with pre-written responses.
NEXT_PUBLIC_GEMINI_API_KEY=

# ─── File Storage (Vercel Blob) ───────────────────────────────
BLOB_READ_WRITE_TOKEN=
